{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": true,

  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "bun.lock",
    ".claude",
    ".agents",
    // The markdown formatter indents a closing `:::` that follows a numbered
    // list, unbalancing the admonition. (CLAUDE.md is a symlink to AGENTS.md.)
    "CLAUDE.md",
    "AGENTS.md",
    "skills-lock.json",
    "tmp"
  ]
}

{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "extends": "@jliocsar/begone-slop/tsconfig",
  "compilerOptions": {
    "types": ["bun"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "brandedSchemaClasses": ["Class", "Error", "Opaque"],
        "namespaceImportPackages": ["effect"],
        "allowedUnstableApis": [
          "@effect/platform-bun",
          "effect/FileSystem",
          "effect/Path",
          "effect/cli",
          "effect/http",
          "effect/process"
        ]
      }
    ]
  }
}

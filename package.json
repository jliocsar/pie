{
  "$schema": "http://json.schemastore.org/package",
  "name": "pie",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.1.2",
      "effect": "4.1.2"
    }
  },
  "scripts": {
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "build": "bun run --filter '*' --if-present build",
    "lint": "oxlint --deny-warnings --disable-nested-config",
    "lint:fix": "oxlint --fix --deny-warnings --disable-nested-config",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "prepare": "git config core.hooksPath .githooks && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@jliocsar/begone-slop": "^0.2.12",
    "@types/bun": "^1.3.14",
    "effect": "catalog:",
    "oxfmt": "^0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}

{
  "$schema": "http://json.schemastore.org/package",
  "name": "boilerplate-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "build": "bun run --filter '*' --if-present build",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky && effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.1",
    "@jliocsar/begone-slop": "^0.1.4",
    "@types/bun": "^1.3.14",
    "effect": "4.0.0-beta.100",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2"
  }
}

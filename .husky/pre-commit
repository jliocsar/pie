#!/usr/bin/env sh
# Format then lint staged files. Two commands because the formatter is a separate
# binary now; it runs first, since formatting moves line breaks the lint rules judge.

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|json)$' || true)

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | xargs bunx oxfmt || exit 1
  printf '%s\n' "$staged" | xargs node_modules/.bin/oxlint --fix --deny-warnings --no-error-on-unmatched-pattern || exit 1
  git update-index --again
fi

bun run typecheck || exit 1
